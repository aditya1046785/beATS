# Copy this file to .env.local and paste your real keys there.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=45000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, only needed when Razorpay payments are enabled.
# Leave these empty to run the upgrade flow in demo mode (payments are simulated).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required for encrypted GitHub token storage.
TOKEN_ENCRYPTION_KEY=

# Optional PDF render timeout in milliseconds.
PDF_RENDER_TIMEOUT_MS=15000
